# QuickBooks OAuth placeholders for local development and Vercel.
# Actual values should be set in the Vercel dashboard, not committed here.
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REDIRECT_URI=https://mc-merge-v7.vercel.app/api/qb/callback

# Optional: send a Discord message when src/data/generate-live-data.sh finishes successfully.
DISCORD_AUTO_UPDATE_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
