// ── Custom dropdown ──
function Dropdown({ label, options, value, onChange, placeholder, renderOption }) {
  const [open, setOpen] = useState(false);
  const ref = useRef(null);

  useEffect(() => {
    const handler = (e) => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); };
    document.addEventListener("mousedown", handler);
    return () => document.removeEventListener("mousedown", handler);
  }, []);

  const selected = typeof options[0] === "string"
    ? options.find((o) => o === value)
    : options.find((o) => o.value === value);

  return (
    <div className="mb-4" ref={ref}>
      <label className="block text-xs text-gray-400 uppercase tracking-wider mb-1.5 font-medium">{label}</label>
      <button
        onClick={() => setOpen(!open)}
        className="w-full flex items-center justify-between bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-left hover:border-gray-500 transition-colors focus:outline-none focus:border-indigo-500"
      >
        <span className={value ? "text-white" : "text-gray-500"}>
          {selected
            ? (typeof selected === "string" ? selected : selected.label)
            : placeholder || "Select..."}
        </span>
        <ChevronIcon direction={open ? "up" : "down"} />
      </button>
      {open && (
        <div className="absolute z-50 mt-1 w-full bg-gray-800 border border-gray-700 rounded-lg shadow-2xl max-h-56 overflow-y-auto" style={{ width: ref.current?.offsetWidth }}>
          {options.map((opt, i) => {
            const val = typeof opt === "string" ? opt : opt.value;
            const lab = typeof opt === "string" ? opt : opt.label;
            const isSelected = val === value;
            return (
              <button
                key={i}
                onClick={() => { onChange(val); setOpen(false); }}
                className={`w-full text-left px-4 py-2.5 hover:bg-gray-700 transition-colors flex items-center justify-between ${isSelected ? "bg-gray-700" : ""}`}
              >
                <div>
                  {renderOption ? renderOption(opt) : (
                    <>
                      <div className="text-sm text-white">{lab}</div>
                      {typeof opt === "object" && opt.desc && (
                        <div className="text-xs text-gray-500 mt-0.5">{opt.desc}</div>
                      )}
                    </>
                  )}
                </div>
                {isSelected && <span className="text-indigo-400"><CheckIcon /></span>}
              </button>
            );
          })}
        </div>
      )}
    </div>
  );
}

