                <Area type="monotone" dataKey="total" stroke="#6366f1" strokeWidth={2} fill="url(#costGrad)" />
              </AreaChart>
            </ResponsiveContainer>
          </div>

          {/* Agent pie chart */}
          <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 className="text-lg font-semibold mb-4">Cost by Sub-Agent</h3>
            <ResponsiveContainer width="100%" height={220}>
              <PieChart>
                <Pie
                  data={agentTotals}
                  dataKey="cost"
                  nameKey="name"
                  cx="50%"
                  cy="50%"
