                />
                <Legend wrapperStyle={{ color: "#9ca3af" }} />
                {MODELS.map((m) => (
                  <Bar key={m.id} dataKey={`${m.id}_cost`} name={m.name} fill={m.color} radius={[2, 2, 0, 0]} stackId="models" />
                ))}
              </BarChart>
            </ResponsiveContainer>
          </div>

          {/* Model summary cards */}
          <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 className="text-lg font-semibold mb-4">Model Summary</h3>
            <div className="space-y-4">
              {modelTotals.map((m) => (
                <div key={m.id} className="border border-gray-800 rounded-lg p-4">
                  <div className="flex items-center gap-2 mb-2">
                    <div className="w-3 h-3 rounded-full" style={{ background: m.color }} />
                    <span className="font-medium text-white">{m.name}</span>
                  </div>
                  <div className="grid grid-cols-2 gap-3">
                    <div>
                      <div className="text-xs text-gray-500">Total Cost</div>
                      <div className="text-lg font-bold text-white">{fmt(m.cost)}</div>
                    </div>
                    <div>
                      <div className="text-xs text-gray-500">Tokens Used</div>
                      <div className="text-lg font-bold text-white">{(m.tokens / 1000000).toFixed(1)}M</div>
                    </div>
                    <div>
                      <div className="text-xs text-gray-500">Input Rate</div>
                      <div className="text-sm text-gray-300">${m.inputPer1k}/1K tok</div>
                    </div>
                    <div>
                      <div className="text-xs text-gray-500">Output Rate</div>
                      <div className="text-sm text-gray-300">${m.outputPer1k}/1K tok</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* By Agent View */}
      {view === "by-agent" && (
        <div className="space-y-6">
          {/* Stacked area chart */}
          <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 className="text-lg font-semibold mb-4">Cost by Sub-Agent Over Time</h3>
            <ResponsiveContainer width="100%" height={400}>
              <AreaChart data={filteredData}>
                <CartesianGrid strokeDasharray="3 3" stroke="#1f2937" />
                <XAxis dataKey="date" tick={{ fill: "#9ca3af", fontSize: 11 }} interval={timeRange === "daily" ? 4 : "preserveStartEnd"} />
                <YAxis tick={{ fill: "#9ca3af", fontSize: 11 }} tickFormatter={(v) => `$${v}`} />
                <Tooltip
                  contentStyle={{ background: "#111827", border: "1px solid #374151", borderRadius: 8, color: "#fff" }}
                  formatter={(v) => [fmt(v), undefined]}
                />
                <Legend wrapperStyle={{ color: "#9ca3af" }} />
                {SUB_AGENTS.map((a) => (
                  <Area key={a.id} type="monotone" dataKey={a.id} name={a.name} stackId="agents" fill={a.color} stroke={a.color} fillOpacity={0.6} />
                ))}
              </AreaChart>
            </ResponsiveContainer>
          </div>

          {/* Agent table */}
          <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 className="text-lg font-semibold mb-4">Sub-Agent Cost Breakdown</h3>
            <table className="w-full">
              <thead>
                <tr className="border-b border-gray-800">
                  <th className="text-left text-xs text-gray-400 uppercase tracking-wider pb-3 pl-3">Agent</th>
                  <th className="text-right text-xs text-gray-400 uppercase tracking-wider pb-3">Period Cost</th>
                  <th className="text-right text-xs text-gray-400 uppercase tracking-wider pb-3">% of Total</th>
                  <th className="text-right text-xs text-gray-400 uppercase tracking-wider pb-3">Avg Daily</th>
                  <th className="text-left text-xs text-gray-400 uppercase tracking-wider pb-3 pl-6">Distribution</th>
                </tr>
              </thead>
              <tbody>
                {agentTotals.map((a) => {
                  const pct = totalAgentCost > 0 ? (a.cost / totalAgentCost) * 100 : 0;
                  const days = timeRange === "daily" ? 30 : timeRange === "weekly" ? 90 : 365;
                  return (
                    <tr key={a.id} className="border-b border-gray-800/50 hover:bg-gray-800/30 transition-colors">
                      <td className="py-3 pl-3">
                        <div className="flex items-center gap-3">
                          <div className="w-3 h-3 rounded-full" style={{ background: a.color }} />
                          <span className="text-white font-medium">{a.name}</span>
                        </div>
                      </td>
                      <td className="text-right text-white font-semibold">{fmt(a.cost)}</td>
                      <td className="text-right text-gray-300">{pct.toFixed(1)}%</td>
                      <td className="text-right text-gray-300">{fmt(a.cost / days)}</td>
                      <td className="pl-6">
                        <div className="w-full bg-gray-800 rounded-full h-2.5">
                          <div className="h-2.5 rounded-full" style={{ width: `${pct}%`, background: a.color }} />
                        </div>
                      </td>
                    </tr>
                  );
                })}
                <tr className="bg-gray-800/30">
                  <td className="py-3 pl-3 text-white font-bold">Total</td>
                  <td className="text-right text-white font-bold">{fmt(totalAgentCost)}</td>
                  <td className="text-right text-white font-bold">100%</td>
                  <td className="text-right text-white font-bold">
                    {fmt(totalAgentCost / (timeRange === "daily" ? 30 : timeRange === "weekly" ? 90 : 365))}
                  </td>
                  <td />
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* By Model View */}
      {view === "by-model" && (
        <div className="space-y-6">
          <div className="grid grid-cols-3 gap-4">
            {modelTotals.map((m) => (
              <div key={m.id} className="bg-gray-900 border border-gray-800 rounded-xl p-6 relative overflow-hidden">
                <div className="absolute top-0 left-0 w-full h-1" style={{ background: m.color }} />
                <div className="flex items-center gap-2 mb-3">
                  <div className="w-3 h-3 rounded-full" style={{ background: m.color }} />
                  <h4 className="font-semibold text-white">{m.name}</h4>
                </div>
                <div className="text-3xl font-bold text-white mb-1">{fmt(m.cost)}</div>
                <div className="text-sm text-gray-400">{(m.tokens / 1000000).toFixed(1)}M tokens consumed</div>
                <div className="mt-3 grid grid-cols-2 gap-2 text-xs">
                  <div className="bg-gray-800 rounded-lg p-2">
                    <div className="text-gray-500">Input</div>
                    <div className="text-white font-medium">${m.inputPer1k}/1K</div>
                  </div>
                  <div className="bg-gray-800 rounded-lg p-2">
                    <div className="text-gray-500">Output</div>
                    <div className="text-white font-medium">${m.outputPer1k}/1K</div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 className="text-lg font-semibold mb-4">Model Cost Trend</h3>
            <ResponsiveContainer width="100%" height={400}>
              <LineChart data={filteredData}>
                <CartesianGrid strokeDasharray="3 3" stroke="#1f2937" />
                <XAxis dataKey="date" tick={{ fill: "#9ca3af", fontSize: 11 }} interval={timeRange === "daily" ? 4 : "preserveStartEnd"} />
                <YAxis tick={{ fill: "#9ca3af", fontSize: 11 }} tickFormatter={(v) => `$${v}`} />
                <Tooltip
                  contentStyle={{ background: "#111827", border: "1px solid #374151", borderRadius: 8, color: "#fff" }}
                  formatter={(v) => [fmt(v), undefined]}
                />
                <Legend wrapperStyle={{ color: "#9ca3af" }} />
                {MODELS.map((m) => (
                  <Line key={m.id} type="monotone" dataKey={`${m.id}_cost`} name={m.name} stroke={m.color} strokeWidth={2} dot={false} />
                ))}
              </LineChart>
            </ResponsiveContainer>
          </div>
        </div>
      )}

      {/* Footer */}
      <div className="mt-8 text-center text-xs text-gray-600">
        Open Claw Mission Control — Project ATLAS — API Cost Analytics v1.0
      </div>
    </div>
  );
}
