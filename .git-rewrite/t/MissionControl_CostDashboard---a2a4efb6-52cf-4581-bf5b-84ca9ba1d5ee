          ))}
        </div>
      </div>

      {/* Overview View */}
      {view === "overview" && (
        <div className="grid grid-cols-3 gap-6">
          {/* Main cost trend */}
          <div className="col-span-2 bg-gray-900 border border-gray-800 rounded-xl p-6">
            <h3 className="text-lg font-semibold mb-4">Total API Cost Trend</h3>
            <ResponsiveContainer width="100%" height={320}>
              <AreaChart data={filteredData}>
                <defs>
                  <linearGradient id="costGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="5%" stopColor="#6366f1" stopOpacity={0.3} />
                    <stop offset="95%" stopColor="#6366f1" stopOpacity={0} />
                  </linearGradient>
                </defs>
                <CartesianGrid strokeDasharray="3 3" stroke="#1f2937" />
                <XAxis dataKey="date" tick={{ fill: "#9ca3af", fontSize: 11 }} interval={timeRange === "daily" ? 4 : "preserveStartEnd"} />
                <YAxis tick={{ fill: "#9ca3af", fontSize: 11 }} tickFormatter={(v) => `$${v}`} />
                <Tooltip
                  contentStyle={{ background: "#111827", border: "1px solid #374151", borderRadius: 8, color: "#fff" }}
