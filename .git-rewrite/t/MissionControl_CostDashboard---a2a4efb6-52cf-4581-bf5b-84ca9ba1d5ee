import { useState, useMemo } from "react";
import { BarChart, Bar, LineChart, Line, PieChart, Pie, Cell, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, AreaChart, Area } from "recharts";

// ── Simulated cost data ──
const SUB_AGENTS = [
  { id: "task-master", name: "Task Master", color: "#6366f1" },
  { id: "fleet-monitor", name: "Fleet Monitor", color: "#0ea5e9" },
  { id: "bot-manager", name: "Bot Manager", color: "#10b981" },
  { id: "alert-engine", name: "Alert Engine", color: "#f59e0b" },
  { id: "biz-analytics", name: "Biz Analytics", color: "#ef4444" },
  { id: "integration-bridge", name: "Integration Bridge", color: "#8b5cf6" },
  { id: "code-reviewer", name: "Code Reviewer", color: "#ec4899" },
  { id: "doc-generator", name: "Doc Generator", color: "#14b8a6" },
];

const MODELS = [
  { id: "claude-opus-4", name: "Claude Opus 4", inputPer1k: 0.015, outputPer1k: 0.075, color: "#6366f1" },
  { id: "claude-sonnet-4", name: "Claude Sonnet 4", inputPer1k: 0.003, outputPer1k: 0.015, color: "#0ea5e9" },
  { id: "claude-haiku-4", name: "Claude Haiku 4.5", inputPer1k: 0.0008, outputPer1k: 0.004, color: "#10b981" },
];

function generateDailyData(days) {
  const data = [];
  const now = new Date(2026, 2, 21);
  for (let d = days - 1; d >= 0; d--) {
    const date = new Date(now);
    date.setDate(date.getDate() - d);
    const dayLabel = date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    const isWeekend = date.getDay() === 0 || date.getDay() === 6;
    const baseFactor = isWeekend ? 0.3 : 1;
    const entry = { date: dayLabel, fullDate: date.toISOString().split("T")[0] };
    let dayTotal = 0;
    SUB_AGENTS.forEach((agent) => {
      const base = (Math.random() * 8 + 2) * baseFactor;
      const cost = Math.round(base * 100) / 100;
      entry[agent.id] = cost;
      dayTotal += cost;
    });
    entry.total = Math.round(dayTotal * 100) / 100;
    MODELS.forEach((model) => {
      const tokens = Math.round((Math.random() * 500000 + 50000) * baseFactor);
      const inputTokens = Math.round(tokens * 0.7);
      const outputTokens = tokens - inputTokens;
      const cost = Math.round((inputTokens / 1000 * model.inputPer1k + outputTokens / 1000 * model.outputPer1k) * 100) / 100;
      entry[`${model.id}_tokens`] = tokens;
      entry[`${model.id}_cost`] = cost;
    });
    data.push(entry);
  }
  return data;
}

const ALL_DATA = generateDailyData(365);

function aggregateByWeek(data) {
  const weeks = [];
  for (let i = 0; i < data.length; i += 7) {
    const chunk = data.slice(i, i + 7);
    const entry = { date: chunk[0].date + " - " + chunk[chunk.length - 1].date };
    let total = 0;
    SUB_AGENTS.forEach((a) => {
      const sum = chunk.reduce((s, d) => s + (d[a.id] || 0), 0);
      entry[a.id] = Math.round(sum * 100) / 100;
      total += sum;
    });
    entry.total = Math.round(total * 100) / 100;
    MODELS.forEach((m) => {
      entry[`${m.id}_cost`] = Math.round(chunk.reduce((s, d) => s + (d[`${m.id}_cost`] || 0), 0) * 100) / 100;
      entry[`${m.id}_tokens`] = chunk.reduce((s, d) => s + (d[`${m.id}_tokens`] || 0), 0);
    });
    weeks.push(entry);
  }
  return weeks;
}

function aggregateByMonth(data) {
  const months = {};
  data.forEach((d) => {
    const key = d.fullDate ? d.fullDate.substring(0, 7) : "unknown";
    if (!months[key]) {
      months[key] = { date: key, total: 0 };
      SUB_AGENTS.forEach((a) => (months[key][a.id] = 0));
      MODELS.forEach((m) => { months[key][`${m.id}_cost`] = 0; months[key][`${m.id}_tokens`] = 0; });
    }
    SUB_AGENTS.forEach((a) => (months[key][a.id] += d[a.id] || 0));
    months[key].total += d.total || 0;
    MODELS.forEach((m) => {
      months[key][`${m.id}_cost`] += d[`${m.id}_cost`] || 0;
      months[key][`${m.id}_tokens`] += d[`${m.id}_tokens`] || 0;
    });
  });
  return Object.values(months).map((m) => {
    SUB_AGENTS.forEach((a) => (m[a.id] = Math.round(m[a.id] * 100) / 100));
    m.total = Math.round(m.total * 100) / 100;
    MODELS.forEach((md) => {
      m[`${md.id}_cost`] = Math.round(m[`${md.id}_cost`] * 100) / 100;
    });
    return m;
  });
}

const fmt = (v) => `$${v.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

export default function CostDashboard() {
  const [timeRange, setTimeRange] = useState("daily");
  const [view, setView] = useState("overview");

  const filteredData = useMemo(() => {
    if (timeRange === "daily") return ALL_DATA.slice(-30);
    if (timeRange === "weekly") return aggregateByWeek(ALL_DATA.slice(-90));
    if (timeRange === "monthly") return aggregateByMonth(ALL_DATA);
    return ALL_DATA;
  }, [timeRange]);

  const totals = useMemo(() => {
    const daily = ALL_DATA.slice(-1)[0]?.total || 0;
    const weekly = ALL_DATA.slice(-7).reduce((s, d) => s + d.total, 0);
    const monthly = ALL_DATA.slice(-30).reduce((s, d) => s + d.total, 0);
    const yearly = ALL_DATA.reduce((s, d) => s + d.total, 0);
    return { daily, weekly, monthly, yearly };
  }, []);

  const agentTotals = useMemo(() => {
    const range = timeRange === "daily" ? ALL_DATA.slice(-30) : timeRange === "weekly" ? ALL_DATA.slice(-90) : ALL_DATA;
    return SUB_AGENTS.map((a) => ({
      ...a,
      cost: Math.round(range.reduce((s, d) => s + (d[a.id] || 0), 0) * 100) / 100,
    })).sort((a, b) => b.cost - a.cost);
  }, [timeRange]);

  const modelTotals = useMemo(() => {
    const range = timeRange === "daily" ? ALL_DATA.slice(-30) : timeRange === "weekly" ? ALL_DATA.slice(-90) : ALL_DATA;
    return MODELS.map((m) => ({
      ...m,
      cost: Math.round(range.reduce((s, d) => s + (d[`${m.id}_cost`] || 0), 0) * 100) / 100,
      tokens: range.reduce((s, d) => s + (d[`${m.id}_tokens`] || 0), 0),
    }));
  }, [timeRange]);

  const totalAgentCost = agentTotals.reduce((s, a) => s + a.cost, 0);

  return (
    <div className="min-h-screen bg-gray-950 text-white p-6">
      {/* Header */}
      <div className="flex items-center justify-between mb-8">
        <div>
          <div className="flex items-center gap-3 mb-1">
            <div className="w-3 h-3 rounded-full bg-emerald-400 animate-pulse" />
            <span className="text-sm text-emerald-400 font-medium tracking-wide uppercase">Mission Control</span>
          </div>
          <h1 className="text-3xl font-bold text-white">API Cost Analytics</h1>
          <p className="text-gray-400 mt-1">Open Claw Enterprise — Real-time model usage and cost tracking</p>
        </div>
        <div className="text-right">
          <div className="text-xs text-gray-500 uppercase tracking-wider">Last Updated</div>
          <div className="text-sm text-gray-300">Mar 21, 2026 — 11:42 PM</div>
        </div>
      </div>

      {/* KPI Cards */}
      <div className="grid grid-cols-4 gap-4 mb-8">
        {[
          { label: "Today", value: totals.daily, delta: "+12%", up: true, accent: "bg-indigo-500" },
          { label: "This Week", value: totals.weekly, delta: "-3%", up: false, accent: "bg-sky-500" },
          { label: "This Month", value: totals.monthly, delta: "+8%", up: true, accent: "bg-emerald-500" },
          { label: "Year to Date", value: totals.yearly, delta: "+22%", up: true, accent: "bg-amber-500" },
        ].map((kpi) => (
          <div key={kpi.label} className="bg-gray-900 border border-gray-800 rounded-xl p-5 relative overflow-hidden">
            <div className={`absolute top-0 left-0 w-full h-1 ${kpi.accent}`} />
            <div className="text-xs text-gray-400 uppercase tracking-wider mb-2">{kpi.label}</div>
            <div className="text-2xl font-bold text-white mb-1">{fmt(kpi.value)}</div>
            <div className={`text-xs font-medium ${kpi.up ? "text-emerald-400" : "text-red-400"}`}>
              {kpi.delta} vs prior period
            </div>
          </div>
        ))}
      </div>

      {/* Controls */}
      <div className="flex items-center gap-4 mb-6">
        <div className="flex bg-gray-900 border border-gray-800 rounded-lg p-1">
          {["overview", "by-agent", "by-model"].map((v) => (
            <button
              key={v}
              onClick={() => setView(v)}
