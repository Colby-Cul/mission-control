// MAIN COMPONENT
// ════════════════════════════════════════════
export default function ProjectManagement() {
  const [viewMode, setViewMode] = useState("kanban");
  const [filterType, setFilterType] = useState("all");
  const [filterValue, setFilterValue] = useState("All");
  const [selectedProject, setSelectedProject] = useState(null);
  const [tasks, setTasks] = useState(makeTasks);
  const [projects, setProjects] = useState(PROJECTS_INIT);

  // Modal state
  const [modal, setModal] = useState({ open: false, type: null, target: null, targetType: null });

  // ── Task-level pause/resume/kill ──
  const handlePauseTask = useCallback((task) => {
    setModal({ open: true, type: "pause", target: task, targetType: "task" });
  }, []);

  const handleKillTask = useCallback((task) => {
    setModal({ open: true, type: "kill", target: task, targetType: "task" });
  }, []);

  const handleResumeTask = useCallback((task) => {
    setTasks(prev => prev.map(t => {
      if (t.id !== task.id) return t;
      return { ...t, status: t.previousStatus || "todo", previousStatus: null, pausedAt: null, killedAt: null };
    }));
  }, []);

  // ── Project-level pause/resume/kill ──
  const handlePauseProject = useCallback((project) => {
    setModal({ open: true, type: "pause", target: project, targetType: "project" });
  }, []);

  const handleKillProject = useCallback((project) => {
    setModal({ open: true, type: "kill", target: project, targetType: "project" });
  }, []);

  const handleResumeProject = useCallback((project) => {
    setProjects(prev => prev.map(p => p.id !== project.id ? p : { ...p, status: "active" }));
    // Resume all paused tasks belonging to this project
    setTasks(prev => prev.map(t => {
      if (t.project !== project.id || t.status !== "paused") return t;
      return { ...t, status: t.previousStatus || "todo", previousStatus: null, pausedAt: null };
    }));
  }, []);

  // ── Confirm modal action ──
  const confirmAction = useCallback(() => {
    const { type, target, targetType } = modal;
    const now = new Date().toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });

    if (targetType === "task") {
      setTasks(prev => prev.map(t => {
        if (t.id !== target.id) return t;
        if (type === "pause") return { ...t, status: "paused", previousStatus: t.status, pausedAt: now };
        if (type === "kill") return { ...t, status: "killed", previousStatus: t.previousStatus || t.status, killedAt: now };
        return t;
      }));
    }

    if (targetType === "project") {
      if (type === "pause") {
        setProjects(prev => prev.map(p => p.id !== target.id ? p : { ...p, status: "paused" }));
        // Pause all active tasks in this project
        setTasks(prev => prev.map(t => {
          if (t.project !== target.id || INACTIVE_STATUSES.includes(t.status) || t.status === "done") return t;
          return { ...t, status: "paused", previousStatus: t.status, pausedAt: now };
        }));
      }
      if (type === "kill") {
        setProjects(prev => prev.map(p => p.id !== target.id ? p : { ...p, status: "killed" }));
        // Kill all non-done tasks in this project
        setTasks(prev => prev.map(t => {
          if (t.project !== target.id || t.status === "done" || t.status === "killed") return t;
          return { ...t, status: "killed", previousStatus: t.previousStatus || t.status, killedAt: now };
        }));
      }
    }

    setModal({ open: false, type: null, target: null, targetType: null });
  }, [modal]);

  // ── Filtered tasks ──
  const filteredTasks = useMemo(() => {
    let t = tasks;
    if (filterType === "department" && filterValue !== "All") {
      const deptAgents = AGENTS.filter(a => a.dept === filterValue).map(a => a.id);
      t = t.filter(task => task.agents.some(a => deptAgents.includes(a)));
    }
    if (filterType === "bot" && filterValue !== "All") {
      const agent = AGENTS.find(a => a.name === filterValue);
      if (agent) t = t.filter(task => task.agents.includes(agent.id));
    }
    if (filterType === "project") {
      const proj = selectedProject || PROJECTS_INIT[0]?.id;
      t = t.filter(task => task.project === proj);
    }
    return t;
  }, [filterType, filterValue, selectedProject, tasks]);

  const currentProject = PROJECTS_INIT.find(p => p.id === (selectedProject || PROJECTS_INIT[0]?.id));

  // Modal text
  const modalTitle = modal.type === "kill"
    ? `Kill ${modal.targetType === "project" ? "Project" : "Task"}?`
    : `Pause ${modal.targetType === "project" ? "Project" : "Task"}?`;
  const modalMessage = modal.type === "kill"
    ? (modal.targetType === "project"
        ? "This will terminate all active tasks in this project and release all assigned agents."
        : "This will terminate the task and release all assigned agents immediately.")
    : (modal.targetType === "project"
        ? "This will pause all active tasks in this project. Agents will be released until the project is resumed."
        : "This will pause the task. The assigned agent(s) will be released until you resume it.");

  return (
    <div className="min-h-screen bg-gray-950 text-white p-6">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <div>
          <div className="flex items-center gap-3 mb-1">
            <div className="w-3 h-3 rounded-full bg-emerald-400 animate-pulse" />
            <span className="text-sm text-emerald-400 font-medium tracking-wide uppercase">Mission Control</span>
          </div>
          <h1 className="text-3xl font-bold text-white">Project & Task Management</h1>
        </div>
        <div className="flex items-center gap-3">
          <div className="flex items-center gap-1 bg-gray-900 border border-gray-800 rounded-lg px-3 py-2">
            <span className="text-xs text-gray-500 mr-2">Agents Online:</span>
            <div className="flex -space-x-1.5">
              {AGENTS.filter(a => a.status === "online").slice(0, 6).map(a => (
                <AgentAvatar key={a.id} agentId={a.id} size="sm" showStatus />
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* Filter bar */}
      <div className="flex items-center gap-4 mb-6">
        <div className="flex bg-gray-900 border border-gray-800 rounded-lg p-1">
          {[
            { key: "all", label: "All Tasks" },
            { key: "department", label: "By Department" },
            { key: "bot", label: "By Agent" },
            { key: "project", label: "By Project" },
            { key: "executive", label: "Executive" },
          ].map(f => (
            <button key={f.key} onClick={() => { setFilterType(f.key); setFilterValue("All"); }}
              className={`px-4 py-2 rounded-md text-sm font-medium transition-all ${
                filterType === f.key ? "bg-indigo-600 text-white" : "text-gray-400 hover:text-white"
              }`}>
              {f.label}
            </button>
          ))}
        </div>

        {filterType === "department" && (
          <div className="flex bg-gray-900 border border-gray-800 rounded-lg p-1">
            {DEPARTMENTS.map(d => (
              <button key={d} onClick={() => setFilterValue(d)}
                className={`px-3 py-1.5 rounded-md text-xs font-medium transition-all ${
                  filterValue === d ? "bg-gray-700 text-white" : "text-gray-400 hover:text-white"
                }`}>{d}</button>
            ))}
          </div>
        )}
        {filterType === "bot" && (
          <div className="flex bg-gray-900 border border-gray-800 rounded-lg p-1 gap-0.5 flex-wrap max-w-xl">
            {BOTS.map(b => (
              <button key={b} onClick={() => setFilterValue(b)}
                className={`px-3 py-1.5 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 ${
                  filterValue === b ? "bg-gray-700 text-white" : "text-gray-400 hover:text-white"
                }`}>
                {b !== "All" && <AgentAvatar agentId={AGENTS.find(a => a.name === b)?.id} size="sm" />}
                {b === "All" ? "All" : ""}
              </button>
            ))}
          </div>
        )}
        {filterType === "project" && (
          <div className="flex bg-gray-900 border border-gray-800 rounded-lg p-1">
            {PROJECTS_INIT.map(p => (
              <button key={p.id} onClick={() => setSelectedProject(p.id)}
                className={`px-3 py-1.5 rounded-md text-xs font-medium transition-all flex items-center gap-2 ${
                  (selectedProject || PROJECTS_INIT[0]?.id) === p.id ? "bg-gray-700 text-white" : "text-gray-400 hover:text-white"
                }`}>
                <div className="w-2 h-2 rounded-full" style={{ background: p.color }} />
                {p.name.split(" ").slice(0, 2).join(" ")}
              </button>
            ))}
          </div>
        )}

        {filterType !== "executive" && (
          <div className="flex bg-gray-900 border border-gray-800 rounded-lg p-1 ml-auto">
            {[
              { key: "kanban", label: "Kanban" },
              { key: "gantt", label: "Gantt" },
              { key: "calendar", label: "Calendar" },
              { key: "table", label: "Table" },
            ].map(v => (
              <button key={v.key} onClick={() => setViewMode(v.key)}
                className={`px-3 py-1.5 rounded-md text-xs font-medium transition-all ${
                  viewMode === v.key ? "bg-gray-700 text-white" : "text-gray-400 hover:text-white"
                }`}>{v.label}</button>
            ))}
          </div>
        )}
      </div>

      {/* Project header when filtering by project */}
      {filterType === "project" && currentProject && (
        <div className="bg-gray-900 border border-gray-800 rounded-xl p-5 mb-6">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <div className="w-4 h-4 rounded-full" style={{ background: currentProject.color }} />
              <div>
                <h2 className="text-xl font-bold text-white">{currentProject.name}</h2>
                <p className="text-xs text-gray-500 mt-0.5">{filteredTasks.length} tasks &middot; {filteredTasks.reduce((s,t)=>s+t.points,0)} story points</p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <span className="text-xs text-gray-500">Project Team:</span>
              <div className="flex items-center gap-2">
                {currentProject.agents.map(id => (
                  <AgentAvatar key={id} agentId={id} size="md" showStatus showName />
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Department header */}
      {filterType === "department" && filterValue !== "All" && (
        <div className="bg-gray-900 border border-gray-800 rounded-xl p-5 mb-6">
          <div className="flex items-center justify-between">
            <div>
              <h2 className="text-xl font-bold text-white">{filterValue} Department</h2>
              <p className="text-xs text-gray-500 mt-0.5">{filteredTasks.length} tasks &middot; {AGENTS.filter(a=>a.dept===filterValue).length} agents</p>
            </div>
            <div className="flex items-center gap-2">
              {AGENTS.filter(a => a.dept === filterValue).map(a => (
                <AgentAvatar key={a.id} agentId={a.id} size="md" showStatus showName />
              ))}
            </div>
          </div>
        </div>
      )}

      {/* Agent header */}
      {filterType === "bot" && filterValue !== "All" && (() => {
        const agent = AGENTS.find(a => a.name === filterValue);
        if (!agent) return null;
        const agentTasks = filteredTasks;
        const done = agentTasks.filter(t=>t.status==="done").length;
        return (
          <div className="bg-gray-900 border border-gray-800 rounded-xl p-5 mb-6">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-4">
                <AgentAvatar agentId={agent.id} size="lg" showStatus />
                <div>
                  <h2 className="text-xl font-bold text-white">{agent.name}</h2>
                  <p className="text-xs text-gray-500 mt-0.5">{agent.dept} &middot; {agent.status} &middot; {agentTasks.length} tasks ({done} done)</p>
                </div>
              </div>
              <div className="text-right">
                <div className="text-2xl font-bold text-white">{agentTasks.reduce((s,t)=>s+t.points,0)}</div>
                <div className="text-xs text-gray-500">story points assigned</div>
              </div>
            </div>
          </div>
        );
      })()}

      {/* Main content */}
      {filterType === "executive" ? (
        <ExecutiveView
          tasks={tasks}
          projects={projects}
          onPauseTask={handlePauseTask}
          onResumeTask={handleResumeTask}
          onKillTask={handleKillTask}
          onPauseProject={handlePauseProject}
          onResumeProject={handleResumeProject}
          onKillProject={handleKillProject}
        />
      ) : (
        <>
          {viewMode === "kanban" && <KanbanView tasks={filteredTasks} onPause={handlePauseTask} onResume={handleResumeTask} onKill={handleKillTask} />}
          {viewMode === "gantt" && <GanttView tasks={filteredTasks} />}
          {viewMode === "calendar" && <CalendarView tasks={filteredTasks} />}
          {viewMode === "table" && <TableView tasks={filteredTasks} onPause={handlePauseTask} onResume={handleResumeTask} onKill={handleKillTask} />}
        </>
      )}

      <div className="mt-8 text-center text-xs text-gray-600">
        Open Claw Mission Control &mdash; Project ATLAS &mdash; Task Management v2.0
      </div>

      {/* Confirmation Modal */}
      <ConfirmModal
        isOpen={modal.open}
        onClose={() => setModal({ open: false, type: null, target: null, targetType: null })}
        onConfirm={confirmAction}
        title={modalTitle}
        message={modalMessage}
        type={modal.type}
        itemName={modal.target?.name || ""}
      />
    </div>
  );
}
