// ── Helper components ──
function AgentAvatar({ agentId, size = "md", showStatus = false, showName = false }) {
  const agent = AGENTS.find(a => a.id === agentId);
  if (!agent) return null;
  const sz = size === "sm" ? "w-6 h-6 text-[9px]" : size === "md" ? "w-8 h-8 text-[10px]" : "w-10 h-10 text-xs";
  const statusDot = size === "sm" ? "w-1.5 h-1.5 -bottom-0 -right-0" : "w-2.5 h-2.5 -bottom-0.5 -right-0.5";
  const statusColor = agent.status === "online" ? "bg-emerald-400" : agent.status === "busy" ? "bg-amber-400" : "bg-gray-500";
  return (
    <div className="flex items-center gap-1.5" title={agent.name}>
      <div className="relative">
        <div className={`${sz} rounded-full flex items-center justify-center font-bold text-white ring-2`}
          style={{ background: agent.color, ringColor: agent.ring, boxShadow: `0 0 0 2px ${agent.ring}33` }}>
          {agent.initials}
        </div>
        {showStatus && <div className={`absolute ${statusDot} rounded-full ${statusColor} ring-2 ring-gray-900`} />}
      </div>
      {showName && <span className="text-sm text-gray-300">{agent.name}</span>}
    </div>
  );
}

function AgentAvatarStack({ agentIds, max = 4 }) {
  const show = agentIds.slice(0, max);
  const extra = agentIds.length - max;
  return (
    <div className="flex items-center -space-x-2">
      {show.map(id => (
        <div key={id} className="relative z-10 hover:z-20 transition-transform hover:scale-110">
          <AgentAvatar agentId={id} size="sm" showStatus />
