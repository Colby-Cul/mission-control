// ── GANTT VIEW ──
function GanttView({ tasks }) {
  const minDate = new Date(2026, 2, 1);
  const maxDate = new Date(2026, 3, 30);
  const totalDays = Math.ceil((maxDate - minDate) / 86400000);
  const dayWidth = 100 / totalDays;

  const weeks = [];
  for (let d = new Date(minDate); d < maxDate; d = new Date(d.getTime() + 7 * 86400000)) {
    weeks.push(d.toLocaleDateString("en-US", { month: "short", day: "numeric" }));
  }

  // Filter out killed, show paused with special styling
  const visibleTasks = tasks.filter(t => t.status !== "killed");

  return (
    <div className="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
      {/* Header */}
      <div className="flex border-b border-gray-800">
        <div className="w-72 flex-shrink-0 px-4 py-3 text-xs text-gray-400 uppercase tracking-wider font-medium bg-gray-900">Task</div>
        <div className="flex-1 flex">
          {weeks.map((w, i) => (
            <div key={i} className="flex-1 px-2 py-3 text-[10px] text-gray-500 text-center border-l border-gray-800">{w}</div>
          ))}
        </div>
      </div>
      {/* Rows */}
      {visibleTasks.slice(0, 15).map((task, i) => {
        const startOffset = Math.max(0, Math.ceil((task.startDate - minDate) / 86400000));
        const duration = Math.ceil((task.endDate - task.startDate) / 86400000);
        const left = startOffset * dayWidth;
        const width = Math.min(duration * dayWidth, 100 - left);
        const s = STATUS[task.status];
        const isPaused = task.status === "paused";
        return (
          <div key={task.id} className={`flex items-center border-b border-gray-800/50 hover:bg-gray-800/30 transition-colors ${i % 2 === 0 ? "bg-gray-900" : "bg-gray-900/50"} ${isPaused ? "opacity-50" : ""}`}>
            <div className="w-72 flex-shrink-0 px-4 py-2.5 flex items-center gap-3">
              <AgentAvatarStack agentIds={task.agents} max={2} />
              <div className="min-w-0">
                <div className={`text-sm text-white truncate ${isPaused ? "text-slate-500" : ""}`}>
                  {isPaused && <span className="mr-1">&#9208;</span>}
                  {task.name}
                </div>
                <div className="text-[10px] text-gray-500">{task.service}</div>
              </div>
            </div>
            <div className="flex-1 relative h-10">
              <div className={`absolute top-1/2 -translate-y-1/2 h-6 rounded-md flex items-center px-2 text-[10px] font-medium text-white ${isPaused ? "opacity-40" : ""}`}
                style={{
                  left: `${left}%`,
                  width: `${Math.max(width, 3)}%`,
                  background: isPaused ? `repeating-linear-gradient(45deg, ${s.color}66, ${s.color}66 4px, ${s.color}33 4px, ${s.color}33 8px)` : s.color + "cc",
                }}>
                {width > 8 && <span className="truncate">{task.points}pt</span>}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
}

// ── CALENDAR VIEW ──
function CalendarView({ tasks }) {
  const year = 2026; const month = 2; // March
  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const days = [];
  for (let i = 0; i < firstDay; i++) days.push(null);
  for (let d = 1; d <= daysInMonth; d++) days.push(d);
  while (days.length % 7 !== 0) days.push(null);

  const tasksForDay = (day) => {
    if (!day) return [];
    const date = new Date(year, month, day);
    return tasks.filter(t => t.startDate <= date && t.endDate >= date && !["done", "killed"].includes(t.status)).slice(0, 3);
  };

  return (
    <div className="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
      <div className="px-6 py-4 border-b border-gray-800 flex items-center justify-between">
        <h3 className="text-lg font-semibold text-white">March 2026</h3>
        <div className="flex gap-2">
          <button className="px-3 py-1 text-xs text-gray-400 bg-gray-800 rounded-md hover:text-white transition-colors">&larr; Feb</button>
          <button className="px-3 py-1 text-xs text-gray-400 bg-gray-800 rounded-md hover:text-white transition-colors">Apr &rarr;</button>
        </div>
      </div>
      <div className="grid grid-cols-7">
        {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map(d => (
          <div key={d} className="px-2 py-2 text-center text-[10px] text-gray-500 uppercase tracking-wider font-medium border-b border-gray-800">{d}</div>
        ))}
        {days.map((day, i) => {
          const dayTasks = tasksForDay(day);
          const isToday = day === 21;
          return (
            <div key={i} className={`min-h-[100px] p-1.5 border-b border-r border-gray-800/50 ${!day ? "bg-gray-950/50" : "hover:bg-gray-800/20"} transition-colors`}>
              {day && (
                <>
                  <div className={`text-xs mb-1 font-medium ${isToday ? "text-indigo-400" : "text-gray-400"} flex items-center gap-1`}>
                    {isToday && <span className="w-5 h-5 bg-indigo-600 rounded-full flex items-center justify-center text-white text-[10px]">{day}</span>}
                    {!isToday && day}
                  </div>
                  {dayTasks.map(t => {
                    const isPaused = t.status === "paused";
                    return (
                      <div key={t.id} className={`flex items-center gap-1 mb-0.5 px-1 py-0.5 rounded text-[10px] truncate ${isPaused ? "opacity-50" : ""}`}
                        style={{ background: STATUS[t.status].color + "18", color: STATUS[t.status].color }}>
                        {isPaused && <span>&#9208;</span>}
                        <AgentAvatarStack agentIds={t.agents} max={1} />
                        <span className="truncate">{t.name.split(" ").slice(0, 3).join(" ")}</span>
                      </div>
                    );
                  })}
                </>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
}

// ── EXECUTIVE VIEW (with Pause/Kill controls) ──
function ExecutiveView({ tasks, projects, onPauseTask, onResumeTask, onKillTask, onPauseProject, onResumeProject, onKillProject }) {
  const activeTasks = tasks.filter(t => !INACTIVE_STATUSES.includes(t.status));
  const totalPoints = activeTasks.reduce((s, t) => s + t.points, 0);
  const donePoints = activeTasks.filter(t => t.status === "done").reduce((s, t) => s + t.points, 0);
  const stuckCount = activeTasks.filter(t => t.status === "stuck").length;
  const activeCount = activeTasks.filter(t => t.status === "working").length;
  const pausedCount = tasks.filter(t => t.status === "paused").length;
  const killedCount = tasks.filter(t => t.status === "killed").length;
  const velocity = totalPoints > 0 ? Math.round((donePoints / totalPoints) * 100) : 0;

  const agentLoad = AGENTS.map(a => {
    const agentTasks = activeTasks.filter(t => t.agents.includes(a.id));
    return { ...a, taskCount: agentTasks.length, points: agentTasks.reduce((s, t) => s + t.points, 0),
      donePct: agentTasks.length ? Math.round(agentTasks.filter(t => t.status === "done").length / agentTasks.length * 100) : 0 };
  }).sort((a, b) => b.taskCount - a.taskCount);

  const projectHealth = projects.map(p => {
    const pTasks = tasks.filter(t => t.project === p.id);
    const active = pTasks.filter(t => !INACTIVE_STATUSES.includes(t.status));
    const done = active.filter(t => t.status === "done").length;
    const stuck = active.filter(t => t.status === "stuck").length;
    const paused = pTasks.filter(t => t.status === "paused").length;
    const killed = pTasks.filter(t => t.status === "killed").length;
    const pct = active.length ? Math.round(done / active.length * 100) : 0;
    const health = p.status === "paused" ? "paused" : p.status === "killed" ? "killed" : stuck > 2 ? "red" : stuck > 0 ? "yellow" : pct > 60 ? "green" : "yellow";
    return { ...p, total: pTasks.length, activeCount: active.length, done, stuck, paused, killed, pct, health };
  });

  const statusDist = Object.entries(STATUS).map(([key, val]) => ({
    key, ...val, count: tasks.filter(t => t.status === key).length,
    pct: tasks.length > 0 ? Math.round(tasks.filter(t => t.status === key).length / tasks.length * 100) : 0,
  }));

  return (
    <div className="space-y-6">
      {/* KPI row — 7 cards now */}
      <div className="grid grid-cols-7 gap-3">
        {[
          { label: "Sprint Velocity", value: `${velocity}%`, sub: `${donePoints} / ${totalPoints} pts`, accent: "#6366f1" },
          { label: "Active Tasks", value: activeCount, sub: "In progress now", accent: "#fdab3d" },
          { label: "Blocked", value: stuckCount, sub: stuckCount > 0 ? "Needs attention" : "All clear", accent: stuckCount > 0 ? "#df2f4a" : "#00c875" },
          { label: "Total Tasks", value: tasks.length, sub: `${activeTasks.filter(t=>t.status==="done").length} completed`, accent: "#0ea5e9" },
          { label: "Paused", value: pausedCount, sub: pausedCount > 0 ? "Awaiting resume" : "None paused", accent: "#94a3b8" },
          { label: "Killed", value: killedCount, sub: killedCount > 0 ? "Terminated" : "None killed", accent: "#64748b" },
          { label: "Agents Online", value: AGENTS.filter(a=>a.status==="online").length + "/" + AGENTS.length, sub: `${AGENTS.filter(a=>a.status==="busy").length} busy`, accent: "#10b981" },
        ].map(kpi => (
          <div key={kpi.label} className="bg-gray-900 border border-gray-800 rounded-xl p-4 relative overflow-hidden">
            <div className="absolute top-0 left-0 w-full h-1" style={{ background: kpi.accent }} />
            <div className="text-[10px] text-gray-400 uppercase tracking-wider mb-1.5">{kpi.label}</div>
            <div className="text-xl font-bold text-white mb-0.5">{kpi.value}</div>
            <div className="text-[10px] text-gray-500">{kpi.sub}</div>
          </div>
        ))}
      </div>

      <div className="grid grid-cols-3 gap-6">
        {/* Project Health — with Pause/Kill controls */}
        <div className="col-span-2 bg-gray-900 border border-gray-800 rounded-xl p-6">
          <div className="flex items-center justify-between mb-4">
            <h3 className="text-lg font-semibold text-white">Project Health</h3>
            <div className="flex items-center gap-2 text-[10px] text-gray-500">
              <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-emerald-400" /> On Track</span>
              <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-amber-400" /> At Risk</span>
              <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-red-400" /> Blocked</span>
              <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-slate-500" /> Paused</span>
            </div>
          </div>
          <div className="space-y-4">
            {projectHealth.map(p => {
              const isProjectPaused = p.status === "paused";
              const isProjectKilled = p.status === "killed";
              return (
                <div key={p.id} className={`border rounded-lg p-4 transition-all ${
                  isProjectKilled ? "border-slate-800 opacity-50 bg-slate-900/30" :
                  isProjectPaused ? "border-slate-700 border-dashed opacity-75 bg-slate-900/20" :
                  "border-gray-800"
                }`}>
                  <div className="flex items-center justify-between mb-3">
                    <div className="flex items-center gap-3">
                      <div className="w-3 h-3 rounded-full" style={{ background: isProjectPaused || isProjectKilled ? "#64748b" : p.color }} />
                      <span className={`font-medium ${isProjectKilled ? "text-slate-600 line-through" : isProjectPaused ? "text-slate-400" : "text-white"}`}>{p.name}</span>
                      <div className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded-full ${
                        p.health === "green" ? "bg-emerald-500/20 text-emerald-400" :
                        p.health === "yellow" ? "bg-amber-500/20 text-amber-400" :
                        p.health === "paused" ? "bg-slate-500/20 text-slate-400" :
                        p.health === "killed" ? "bg-slate-700/30 text-slate-600" :
                        "bg-red-500/20 text-red-400"
                      }`}>
                        {p.health === "green" ? "On Track" : p.health === "yellow" ? "At Risk" : p.health === "paused" ? "Paused" : p.health === "killed" ? "Killed" : "Blocked"}
                      </div>
                    </div>
                    <div className="flex items-center gap-3">
                      <span className="text-sm text-gray-400">{p.pct}%</span>
                      {/* Project-level Pause/Kill controls */}
                      <div className="flex items-center gap-1">
                        {isProjectKilled ? (
                          <button onClick={() => onResumeProject(p)}
                            className="flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/25 text-[10px] font-medium transition-all">
                            <UndoIcon /> Restore
                          </button>
                        ) : isProjectPaused ? (
                          <>
                            <button onClick={() => onResumeProject(p)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/25 text-[10px] font-medium transition-all">
                              <PlayIcon /> Resume
                            </button>
                            <button onClick={() => onKillProject(p)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-red-500/10 text-red-400 hover:bg-red-500/25 text-[10px] font-medium transition-all">
                              <KillIcon /> Kill
                            </button>
                          </>
                        ) : (
                          <>
                            <button onClick={() => onPauseProject(p)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-amber-500/10 text-amber-400 hover:bg-amber-500/25 text-[10px] font-medium transition-all">
                              <PauseIcon /> Pause
                            </button>
                            <button onClick={() => onKillProject(p)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-red-500/10 text-red-400 hover:bg-red-500/25 text-[10px] font-medium transition-all">
                              <KillIcon /> Kill
                            </button>
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                  {!isProjectKilled && (
                    <>
                      <div className="w-full bg-gray-800 rounded-full h-2 mb-3">
                        <div className="h-2 rounded-full transition-all" style={{ width: `${p.pct}%`, background: isProjectPaused ? "#94a3b8" : p.color }} />
                      </div>
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-4 text-xs text-gray-500">
                          <span>{p.activeCount} active</span>
                          <span className="text-emerald-400">{p.done} done</span>
                          {p.stuck > 0 && <span className="text-red-400">{p.stuck} stuck</span>}
                          {p.paused > 0 && <span className="text-slate-400">{p.paused} paused</span>}
                          {p.killed > 0 && <span className="text-slate-600">{p.killed} killed</span>}
                        </div>
                        <div className="flex items-center gap-1">
                          <span className="text-[10px] text-gray-600 mr-1">Team:</span>
                          <AgentAvatarStack agentIds={p.agents} max={5} />
                        </div>
                      </div>
                    </>
                  )}
                </div>
              );
            })}
          </div>
        </div>

        {/* Agent Workload */}
        <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 className="text-lg font-semibold text-white mb-4">Agent Workload</h3>
          <div className="space-y-3">
            {agentLoad.map(a => (
              <div key={a.id} className="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-800/30 transition-colors">
                <AgentAvatar agentId={a.id} size="md" showStatus />
                <div className="flex-1 min-w-0">
                  <div className="flex items-center justify-between">
                    <span className="text-sm text-white font-medium">{a.name}</span>
                    <span className="text-xs text-gray-500">{a.taskCount} tasks</span>
                  </div>
                  <div className="flex items-center gap-2 mt-1">
                    <div className="flex-1 bg-gray-800 rounded-full h-1.5">
                      <div className="h-1.5 rounded-full" style={{ width: `${a.donePct}%`, background: a.color }} />
                    </div>
                    <span className="text-[10px] text-gray-500">{a.donePct}%</span>
                  </div>
                  <div className="text-[10px] text-gray-600 mt-0.5">{a.points} story points assigned</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Executive Command Center — Task-level Pause/Kill */}
      <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-3">
            <h3 className="text-lg font-semibold text-white">Command Center</h3>
            <span className="text-[10px] bg-indigo-500/20 text-indigo-400 px-2 py-0.5 rounded-full font-medium uppercase">Executive Controls</span>
          </div>
          <div className="flex items-center gap-2 text-[10px] text-gray-500">
            <span>Hover task row for controls</span>
          </div>
        </div>
        <div className="overflow-hidden rounded-lg border border-gray-800">
          <table className="w-full">
            <thead>
              <tr className="bg-gray-800/50">
                <th className="text-left text-[10px] text-gray-400 uppercase tracking-wider py-2.5 pl-4 font-medium">Task</th>
                <th className="text-left text-[10px] text-gray-400 uppercase tracking-wider py-2.5 font-medium">Agents</th>
                <th className="text-left text-[10px] text-gray-400 uppercase tracking-wider py-2.5 font-medium">Status</th>
                <th className="text-left text-[10px] text-gray-400 uppercase tracking-wider py-2.5 font-medium">Project</th>
                <th className="text-right text-[10px] text-gray-400 uppercase tracking-wider py-2.5 pr-4 font-medium">Actions</th>
              </tr>
            </thead>
            <tbody>
              {tasks.map((task, i) => {
                const proj = projects.find(p => p.id === task.project);
                const isPaused = task.status === "paused";
                const isKilled = task.status === "killed";
                const isDone = task.status === "done";
                return (
                  <tr key={task.id} className={`border-b border-gray-800/50 transition-colors group ${
                    isKilled ? "opacity-40" : isPaused ? "opacity-60" : ""
                  } ${i % 2 === 0 ? "" : "bg-gray-900/30"} hover:bg-gray-800/30`}>
                    <td className="py-2.5 pl-4">
                      <div className={`text-sm font-medium ${isKilled ? "text-slate-600 line-through" : isPaused ? "text-slate-400" : "text-white"}`}>
                        {isPaused && <span className="mr-1">&#9208;</span>}
                        {isKilled && <span className="mr-1">&#10006;</span>}
                        {task.name}
                      </div>
                      <div className="text-[10px] text-gray-600">{task.service} &middot; {task.points}pt</div>
                    </td>
                    <td className="py-2.5">
                      <AgentAvatarStack agentIds={task.agents} max={3} />
                    </td>
                    <td className="py-2.5"><StatusBadge status={task.status} /></td>
                    <td className="py-2.5">
                      <div className="flex items-center gap-2">
                        <div className="w-2 h-2 rounded-full" style={{ background: proj?.color }} />
                        <span className="text-xs text-gray-400">{proj?.name?.split(" ").slice(0, 2).join(" ")}</span>
                      </div>
                    </td>
                    <td className="py-2.5 pr-4">
                      <div className="flex items-center gap-1 justify-end">
                        {!isDone && !isKilled && !isPaused && (
                          <>
                            <button onClick={() => onPauseTask(task)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-amber-500/10 text-amber-400 hover:bg-amber-500/25 text-[10px] font-medium opacity-0 group-hover:opacity-100 transition-all">
                              <PauseIcon /> Pause
                            </button>
                            <button onClick={() => onKillTask(task)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-red-500/10 text-red-400 hover:bg-red-500/25 text-[10px] font-medium opacity-0 group-hover:opacity-100 transition-all">
                              <KillIcon /> Kill
                            </button>
                          </>
                        )}
                        {isPaused && (
                          <>
                            <button onClick={() => onResumeTask(task)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/25 text-[10px] font-medium transition-all">
                              <PlayIcon /> Resume
                            </button>
                            <button onClick={() => onKillTask(task)}
                              className="flex items-center gap-1 px-2 py-1 rounded-md bg-red-500/10 text-red-400 hover:bg-red-500/25 text-[10px] font-medium opacity-0 group-hover:opacity-100 transition-all">
                              <KillIcon /> Kill
                            </button>
                          </>
                        )}
                        {isKilled && (
                          <button onClick={() => onResumeTask(task)}
                            className="flex items-center gap-1 px-2 py-1 rounded-md bg-slate-700/50 text-slate-400 hover:bg-emerald-500/15 hover:text-emerald-400 text-[10px] font-medium transition-all">
                            <UndoIcon /> Restore
                          </button>
                        )}
                        {isDone && (
                          <span className="text-[10px] text-emerald-500/60">&#10003; Complete</span>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {/* Status Distribution */}
      <div className="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <h3 className="text-lg font-semibold text-white mb-4">Status Distribution</h3>
        <div className="flex items-center gap-1 h-8 rounded-lg overflow-hidden mb-4">
          {statusDist.filter(s => s.count > 0).map(s => (
            <div key={s.key} className="h-full transition-all relative group" style={{ width: `${s.pct}%`, background: s.color }}
              title={`${s.label}: ${s.count} (${s.pct}%)`}>
              <div className="absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-10">
                {s.label}: {s.count}
              </div>
            </div>
          ))}
        </div>
        <div className="flex items-center justify-center gap-4 flex-wrap">
          {statusDist.map(s => (
            <div key={s.key} className="flex items-center gap-2 text-xs">
              <div className="w-2.5 h-2.5 rounded-sm" style={{ background: s.color }} />
              <span className="text-gray-400">{s.label}</span>
              <span className="text-white font-medium">{s.count}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

