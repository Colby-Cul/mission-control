// ── TASK ACTION BUTTONS (Pause / Resume / Kill) ──
function TaskActions({ task, onPause, onResume, onKill, compact = false }) {
  const isPaused = task.status === "paused";
  const isKilled = task.status === "killed";
  const isDone = task.status === "done";

  if (isDone) return null;

  const btnClass = compact
    ? "p-1 rounded-md transition-all opacity-0 group-hover:opacity-100"
    : "p-1.5 rounded-lg transition-all";

  if (isKilled) {
    return (
      <div className="flex items-center gap-1">
        <button onClick={(e) => { e.stopPropagation(); onResume(task); }}
          className={`${btnClass} bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/25`} title="Restore">
          <UndoIcon />
        </button>
      </div>
    );
  }

  return (
    <div className="flex items-center gap-1">
      {isPaused ? (
        <button onClick={(e) => { e.stopPropagation(); onResume(task); }}
          className={`${btnClass} bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/25`} title="Resume">
          <PlayIcon />
        </button>
      ) : (
        <button onClick={(e) => { e.stopPropagation(); onPause(task); }}
          className={`${btnClass} bg-amber-500/10 text-amber-400 hover:bg-amber-500/25`} title="Pause">
          <PauseIcon />
        </button>
      )}
      <button onClick={(e) => { e.stopPropagation(); onKill(task); }}
        className={`${btnClass} bg-red-500/10 text-red-400 hover:bg-red-500/25`} title="Kill">
        <KillIcon />
      </button>
    </div>
  );
}

